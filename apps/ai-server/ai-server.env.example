# HTTP listener. Port 0 is allowed for local tests.
AI_SERVER_LISTEN_ADDRESS=0.0.0.0
AI_SERVER_LISTEN_PORT=8080
# Optional override for Nacos registration. When omitted, ai-server chooses
# the first non-loopback IPv4 interface (and falls back to 127.0.0.1).
AI_SERVER_ADVERTISE_ADDRESS=127.0.0.1
AI_SERVER_SERVICE_NAME=ploto-ai-server
AI_SERVER_SERVICE_GROUP=DEFAULT_GROUP
# 0 waits indefinitely. The listener is not bound before the first complete snapshot.
AI_SERVER_INITIAL_CONFIG_TIMEOUT_MS=60000

# Required startup component. Request workers generate audit JSON and submit it
# best effort to the shared asynchronous log thread. Files use mode 0600.
AI_SERVER_AUDIT_LOG_PATH=ai-server-audit.ndjson
AI_SERVER_AUDIT_MAX_RECORD_BYTES=134217728
# 0 disables rotation. A single oversized record is never split.
AI_SERVER_AUDIT_ROTATE_BYTES=1073741824
AI_SERVER_AUDIT_MAX_ARCHIVES=30

# Comma-separated IPv4 or IPv6 literals. At least one address is required.
NACOS_SERVER_ADDRESSES=127.0.0.1
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848

# Optional Nacos client settings.
NACOS_NAMESPACE_ID=
NACOS_TENANT=
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_CONTEXT_PATH=/nacos
NACOS_CLIENT_VERSION=fiber-ai-server/1.0

# Optional CAT tracing. Leave every value empty to disable CAT. When enabled,
# app key, hostname, IP, and at least one router or collector are required.
CAT_APP_KEY=
CAT_HOSTNAME=
CAT_IP=
# Comma-separated IPv4:port or [IPv6]:port endpoints.
CAT_ROUTER_ADDRESSES=
CAT_COLLECTOR_ADDRESSES=
