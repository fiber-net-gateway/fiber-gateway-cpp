# HTTP listener. Port 0 is allowed for local tests.
AI_SERVER_LISTEN_ADDRESS=0.0.0.0
AI_SERVER_LISTEN_PORT=8080
# Optional override for Nacos registration. When omitted, a concrete IPv4
# listen address wins; otherwise ai-server selects an UP non-loopback,
# non-link-local IPv4 interface deterministically. Startup fails if none exists.
AI_SERVER_ADVERTISE_ADDRESS=127.0.0.1
AI_SERVER_SERVICE_NAME=fiber-ai-server
AI_SERVER_SERVICE_GROUP=DEFAULT_GROUP
# Java-compatible development defaults. The registered Nacos cluster is
# <zone>-<cluster>, for example daily1-dev.
AI_SERVER_ZONE=daily1
AI_SERVER_CLUSTER=dev
# 0 waits indefinitely. The listener is not bound before the first complete snapshot.
AI_SERVER_INITIAL_CONFIG_TIMEOUT_MS=60000

# Required standalone logging configuration. A relative path is resolved
# against this environment file.
AI_SERVER_LOG_CONFIG_PATH=ai-server.logging.json
# Java-compatible MCP tool cache. Relative paths are resolved against this file.
AI_SERVER_MCP_CACHE_DIR=cache/ai

# Comma-separated IPv4 or IPv6 literals. At least one address is required.
NACOS_SERVER_ADDRESSES=127.0.0.1
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848

# Optional Nacos client settings. Naming defaults to Java-compatible "public";
# ConfigService tenant remains empty by default.
NACOS_NAMESPACE_ID=public
NACOS_TENANT=
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_CLIENT_VERSION=fiber-ai-server/1.0

# Optional CAT tracing. Leave every value empty to disable CAT. When enabled,
# app key, hostname, and at least one router or collector are required.
# CAT_IP optionally overrides the resolved Nacos registration IPv4.
CAT_APP_KEY=
CAT_HOSTNAME=
CAT_IP=
# Comma-separated IPv4:port or [IPv6]:port endpoints.
CAT_ROUTER_ADDRESSES=
CAT_COLLECTOR_ADDRESSES=
